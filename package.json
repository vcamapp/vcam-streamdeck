{
  "name": "vcam-streamdeck",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.vcamapp.vcam\"",
    "link": "npm run build && streamdeck link .build/com.vcamapp.vcam.sdPlugin",
    "test": "vitest run",
    "check": "tsc -p . && npm run build && streamdeck validate .build/com.vcamapp.vcam.sdPlugin --no-update-check",
    "pack": "npm run build && streamdeck pack .build/com.vcamapp.vcam.sdPlugin --output .build --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "@elgato/utils": "0.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "rollup": "^4.68.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
